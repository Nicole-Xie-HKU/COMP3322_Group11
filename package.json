{
  "name": "hkuplan",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "npm --prefix backend ci && npm --prefix frontend ci",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "db:setup": "npm --prefix backend run db:setup",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test && node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.mjs",
    "db:migrate": "npm --prefix backend run db:migrate --",
    "db:import": "npm --prefix backend run db:import --",
    "test:mysql": "npm --prefix backend run test:mysql --",
    "check": "npm --prefix backend run check --",
    "setup:env": "npm --prefix backend run setup:env --",
    "docs:api": "npm --prefix backend run docs:api --",
    "smoke": "npm --prefix backend run smoke --"
  }
}
