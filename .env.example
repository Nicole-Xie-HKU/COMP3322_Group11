# Generate random local values without overwriting .env: npm run setup:env
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3001
CURSOR_SECRET=replace-with-random-32-or-more-characters
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hkuplanner
DB_USER=hkuplanner
DB_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-password
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace-with-same-value-as-MYSQL_ROOT_PASSWORD
# Production: HTTPS origin(s), NODE_ENV=production, reverse proxy and TRUST_PROXY=1 only if one trusted proxy.
